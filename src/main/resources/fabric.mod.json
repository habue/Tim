{
  "schemaVersion": 1,
  "id": "tim",
  "version": "${version}",
  "name": "Tim (Trail Investigator Module)",
  "description": "A Meteor Client addon built with AI featuring a handful of utilities for hunting.",
  "authors": [
    "riths"
  ],
  "contact": {
    "sources": "https://github.com/habue/Tim"
  },
  "license": "CC0-1.0",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.example.addon.Tim"
    ]
  },
  "mixins": [
    "Tim.mixins.json"
  ],
  "custom": {
    "meteor-client:colors": 75
  },
  "depends": {
    "java": ">=25",
    "minecraft": "26.1.2",
    "meteor-client": "26.1.2-SNAPSHOT",
    "fabricloader": ">=0.19.2"
  },
  "suggests": {
    "xaeroworldmap": "*",
    "xaerominimapfair": "*"
  }
}
